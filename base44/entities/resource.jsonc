// A real public program or community resource (spec 5). Public read.
{
  "name": "Resource",
  "description": "A real public program or community resource (spec 5). Public read.",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "Stable id used in plans"
    },
    "program_key": {
      "type": "string",
      "description": "De-duplication key, e.g. \"snap\""
    },
    "name": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "food",
          "housing",
          "utilities",
          "healthcare",
          "school_childcare",
          "employment",
          "transportation",
          "cash_assistance",
          "legal",
          "mental_health"
        ]
      }
    },
    "what_it_gives_en": {
      "type": "string"
    },
    "what_it_gives_es": {
      "type": "string"
    },
    "who_its_for_en": {
      "type": "string"
    },
    "who_its_for_es": {
      "type": "string"
    },
    "how_to_apply_en": {
      "type": "string"
    },
    "how_to_apply_es": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Documents to bring (English)"
    },
    "documents_es": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Documents to bring (Spanish)"
    },
    "apply_url": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "hours": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "walk_in": {
      "type": "boolean"
    },
    "apply_online": {
      "type": "boolean"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_type": {
      "type": "string",
      "description": "Geographic reach",
      "enum": [
        "national",
        "state",
        "region",
        "county",
        "city"
      ]
    },
    "coverage_state": {
      "type": "string"
    },
    "coverage_zip_prefixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_counties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signals": {
      "type": "object",
      "description": "Matching signals: needs_children, child_under_5, pregnant, job_loss, veteran_only, senior, disability, student, unhoused, low_income"
    },
    "is_crisis": {
      "type": "boolean",
      "default": false
    },
    "priority_weight": {
      "type": "number"
    },
    "source_url": {
      "type": "string"
    },
    "last_checked_date": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium"
      ]
    },
    "origin": {
      "type": "string",
      "description": "curated or research"
    }
  },
  "required": [
    "slug",
    "name",
    "categories",
    "coverage_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
