// An anonymous saved plan. Never stores free text, names, addresses or document numbers.
{
  "name": "PlanSession",
  "description": "An anonymous saved plan. Never stores free text, names, addresses or document numbers.",
  "type": "object",
  "properties": {
    "ns": {
      "type": "string",
      "description": "Namespace for demo data (\"loop\"); used by Reset demo"
    },
    "share_token": {
      "type": "string",
      "description": "Long random token for /p/:token"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "es"
      ]
    },
    "profile": {
      "type": "object",
      "description": "Structured answers only"
    },
    "county": {
      "type": "string"
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Matched resources"
    },
    "plan": {
      "type": "object",
      "description": "tonight / today / this_week / bring / fallbacks / encouragement"
    },
    "plan_source": {
      "type": "string"
    },
    "tonight": {
      "type": "object"
    },
    "checklist_state": {
      "type": "object"
    },
    "request_key": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "share_token"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
