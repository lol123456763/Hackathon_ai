// An anonymous saved plan. No names, addresses, or other personal identifiers are stored.
// All access goes through backend functions (service role) using the unguessable share_token,
// so no user can list or read other people's plans. Admins can read for aggregate analytics.
{
  "name": "PlanSession",
  "type": "object",
  "properties": {
    "share_token": { "type": "string", "description": "Unguessable random token used in the /plan/:token link" },
    "language": { "type": "string", "enum": ["en", "es"], "default": "en" },
    "profile": {
      "type": "object",
      "description": "Answers used for matching (no personal identifiers)",
      "properties": {
        "zip": { "type": "string" },
        "household_size": { "type": "number" },
        "children_count": { "type": "number" },
        "child_under_5": { "type": "boolean" },
        "income_range": { "type": "string" },
        "situations": { "type": "array", "items": { "type": "string" } },
        "needs": { "type": "array", "items": { "type": "string" } },
        "urgency": { "type": "string" }
      }
    },
    "county": { "type": "string", "description": "County derived from ZIP, for analytics" },
    "matches": {
      "type": "array",
      "description": "Matched resources at the time the plan was made",
      "items": {
        "type": "object",
        "properties": {
          "slug": { "type": "string" },
          "level": { "type": "string" },
          "score": { "type": "number" },
          "distance": { "type": "number" },
          "matched_categories": { "type": "array", "items": { "type": "string" } },
          "reasons": { "type": "array", "items": { "type": "object" } },
          "fallback": { "type": "boolean" }
        }
      }
    },
    "action_plan": { "type": "object", "description": "today / bring / this_week / fallbacks / encouragement" },
    "plan_source": { "type": "string", "enum": ["ai", "rules"] },
    "estimates": { "type": "array", "items": { "type": "object" }, "description": "Rough benefit estimates" },
    "checklist_state": { "type": "object", "description": "Which steps/documents the person checked off" },
    "saved_resources": { "type": "array", "items": { "type": "string" }, "description": "Slugs the person added to their plan" },
    "expires_at": { "type": "string", "format": "date", "description": "Plans are deleted after this date (90 days)" }
  },
  "required": ["share_token"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
