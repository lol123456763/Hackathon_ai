// Anonymous "was this helpful?" feedback. Anyone can submit; only admins can read.
{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "plan_token": { "type": "string", "description": "share_token of the plan (optional)" },
    "resource_slug": { "type": "string", "description": "Resource the feedback is about (optional)" },
    "rating": { "type": "string", "enum": ["helpful", "not_helpful", "wrong_info"] },
    "comment": { "type": "string", "maxLength": 1000 },
    "language": { "type": "string", "enum": ["en", "es"] }
  },
  "required": ["rating"],
  "rls": {
    "create": true,
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
