// Base44 Project Configuration
// Docs: https://docs.base44.com/developers/backend/overview/project-structure
{
  "name": "BenefitBridge",
  "description": "Tell us your situation. Get an exact plan for the help you may qualify for in Texas.",

  // Anyone can use the app without an account. Admin pages check the admin role.
  "visibility": "public",

  // Site/hosting configuration for the React client (built with Vite into ./dist)
  "site": {
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "serveCommand": "npm run dev",
    "outputDirectory": "./dist"
  }
}
